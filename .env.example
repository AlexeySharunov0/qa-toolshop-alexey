# Copy to .env and adjust if your local Toolshop runs on other ports.
# The application itself must run locally:
#   UI  - http://localhost:4200
#   API - http://localhost:8091
# Never commit the real .env file.

UI_URL=http://localhost:4200
API_URL=http://localhost:8091

# Credentials of the seeded demo customer.
# Used only for read-only smoke checks; every automated test creates its own
# throw-away user through the API instead (see src/data/factories.ts).
DEMO_CUSTOMER_EMAIL=customer@practicesoftwaretesting.com
DEMO_CUSTOMER_PASSWORD=welcome01

# Seeded admin (admin area is out of scope, kept for completeness)
DEMO_ADMIN_EMAIL=admin@practicesoftwaretesting.com
DEMO_ADMIN_PASSWORD=welcome01
